---
import '../styles/global.css';
import Header from '../components/Header.astro';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Portfolio | Contact</title>
  </head>
  <body class="min-h-screen bg-white text-gray-900">
    <Header activePath="/contact" />

    <main class="relative overflow-hidden">
      <!-- Background blobs -->
      <div class="pointer-events-none absolute inset-0 -z-10">
        <div class="absolute -top-24 -left-24 h-72 w-72 rounded-full bg-maroon-100/70 blur-3xl"></div>
        <div class="absolute top-1/3 -right-28 h-80 w-80 rounded-full bg-gold-100/60 blur-3xl"></div>
        <div class="absolute bottom-0 left-1/2 h-60 w-60 rounded-full bg-maroon-50/80 blur-3xl"></div>
      </div>

      <!-- Hero intro -->
      <section class="mx-auto max-w-4xl px-4 pt-14 pb-4 sm:px-6 lg:px-8 text-center">
        <span class="inline-flex items-center rounded-full border border-maroon-200 bg-white px-3 py-1 text-sm font-semibold text-maroon-600 shadow-sm">
          Let's Connect
        </span>
        <h1 class="mt-5 text-4xl font-black tracking-tight text-gray-900 sm:text-5xl">
          Want to work together?
        </h1>
        <p class="mx-auto mt-4 max-w-2xl text-lg leading-8 text-gray-600">
          I'm open to collaborations, internship opportunities, and meaningful projects. Feel free to reach out through any of my channels below.
        </p>

        <!-- Availability badge -->
        <div class="mt-6 inline-flex items-center gap-2 rounded-full border border-green-200 bg-green-50 px-4 py-2 text-sm font-semibold text-green-700 shadow-sm">
          <span class="relative flex h-2.5 w-2.5">
            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-green-400 opacity-75"></span>
            <span class="relative inline-flex h-2.5 w-2.5 rounded-full bg-green-500"></span>
          </span>
          Currently open to opportunities
        </div>
      </section>

      <!-- Contact cards grid -->
      <section class="mx-auto max-w-6xl px-4 py-10 sm:px-6 lg:px-8">
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-2">

          <!-- GitHub -->
          <article class="group relative overflow-hidden rounded-3xl border border-gray-200 bg-white p-8 shadow-sm transition duration-300 hover:-translate-y-1 hover:shadow-xl hover:border-gray-300">
            <div class="absolute inset-0 bg-gradient-to-br from-gray-50 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
            <div class="relative">
              <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-gray-900 text-white shadow-md">
                <svg class="h-7 w-7" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.008.069-.008 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
                </svg>
              </div>
              <div class="mt-5">
                <p class="text-xs font-bold uppercase tracking-[0.16em] text-gray-400">Source Code & Projects</p>
                <h3 class="mt-1 text-2xl font-bold text-gray-900">GitHub</h3>
                <p class="mt-3 text-base leading-7 text-gray-600">
                  Browse my repositories, open-source contributions, and project source code.
                </p>
                <p class="mt-2 text-sm font-semibold text-gray-500">@Azzurra56</p>
              </div>
              <a
                href="https://github.com/Azzurra56"
                target="_blank"
                rel="noreferrer"
                class="mt-6 inline-flex items-center gap-2 rounded-full bg-gray-900 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-gray-700"
              >
                View Profile
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H4" />
                </svg>
              </a>
            </div>
          </article>

          <!-- LinkedIn -->
          <article class="group relative overflow-hidden rounded-3xl border border-gray-200 bg-white p-8 shadow-sm transition duration-300 hover:-translate-y-1 hover:shadow-xl hover:border-[#0A66C2]/30">
            <div class="absolute inset-0 bg-gradient-to-br from-blue-50/50 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
            <div class="relative">
              <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-[#0A66C2] text-white shadow-md">
                <svg class="h-7 w-7" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M19 0h-14c-2.76 0-5 2.24-5 5v14c0 2.76 2.24 5 5 5h14c2.76 0 5-2.24 5-5v-14c0-2.76-2.24-5-5-5zm-11 19h-3v-9h3v9zm-1.5-10.28c-.97 0-1.75-.79-1.75-1.75s.78-1.75 1.75-1.75 1.75.79 1.75 1.75-.78 1.75-1.75 1.75zm13.5 10.28h-3v-4.5c0-1.08-.02-2.47-1.5-2.47-1.5 0-1.73 1.17-1.73 2.39v4.58h-3v-9h2.89v1.23h.04c.4-.75 1.38-1.54 2.84-1.54 3.04 0 3.6 2 3.6 4.59v4.72z" />
                </svg>
              </div>
              <div class="mt-5">
                <p class="text-xs font-bold uppercase tracking-[0.16em] text-gray-400">Professional Network</p>
                <h3 class="mt-1 text-2xl font-bold text-gray-900">LinkedIn</h3>
                <p class="mt-3 text-base leading-7 text-gray-600">
                  Connect with me professionally for networking, job opportunities, and career conversations.
                </p>
                <p class="mt-2 text-sm font-semibold text-gray-500">John Clarence A. Dela Cruz</p>
              </div>
              <a
                href="https://www.linkedin.com/in/john-clarence-a-dela-cruz-33472727b/?locale=en"
                target="_blank"
                rel="noreferrer"
                class="mt-6 inline-flex items-center gap-2 rounded-full bg-[#0A66C2] px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-[#084B8A]"
              >
                View Profile
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H4" />
                </svg>
              </a>
            </div>
          </article>
        </div>
      </section>

      <!-- Quick info strip -->
      <section class="mx-auto max-w-6xl px-4 pb-14 sm:px-6 lg:px-8">
        <div class="rounded-4xl border border-maroon-100 bg-gradient-to-r from-maroon-50 via-white to-gold-50 p-8 shadow-sm sm:p-10">
          <div class="grid gap-8 md:grid-cols-3 text-center md:text-left">
            <!-- Location -->
            <div class="flex flex-col items-center md:items-start gap-2">
              <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-maroon-100 text-maroon-700">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              </div>
              <p class="text-xs font-bold uppercase tracking-[0.16em] text-maroon-700">Location</p>
              <p class="text-sm font-semibold text-gray-800">Taguig City, Philippines</p>
            </div>
            <!-- Role -->
            <div class="flex flex-col items-center md:items-start gap-2">
              <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-maroon-100 text-maroon-700">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              </div>
              <p class="text-xs font-bold uppercase tracking-[0.16em] text-maroon-700">Current Role</p>
              <p class="text-sm font-semibold text-gray-800">Aspiring Web Dev & IT Support</p>
            </div>
            <!-- Education -->
            <div class="flex flex-col items-center md:items-start gap-2">
              <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-maroon-100 text-maroon-700">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 14l9-5-9-5-9 5 9 5z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z" />
                </svg>
              </div>
              <p class="text-xs font-bold uppercase tracking-[0.16em] text-maroon-700">Education</p>
              <p class="text-sm font-semibold text-gray-800">BSIT — PUP Taguig Campus</p>
            </div>
          </div>
        </div>
      </section>
    </main>
  </body>
</html>