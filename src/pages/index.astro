---
import '../styles/global.css';
import Header from '../components/Header.astro';
import smis from '../assets/smis.png';
import Game from '../assets/Game.png';
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Portfolio</title>
  </head>
  <body class="bg-white">
<Header activePath="/" />

  <div class="container mx-auto px-4 py-8 lg:px-16 lg:py-16">
    <div class="mb-16">
      <h2 class="text-4xl sm:text-5xl lg:text-6xl font-black tracking-tight text-gray-900 mb-3 leading-tight">Featured Projects</h2>
      <div class="h-1.5 w-20 bg-maroon-600 rounded-full"></div>
      <p class="mt-6 text-lg text-gray-600 font-medium max-w-2xl">Explore my latest work and projects that showcase my skills in web development and design.</p>
    </div>
    <div class="-m-1 flex flex-wrap md:-m-2 lg:-m-3">
      <div class="flex w-full sm:w-1/2 lg:w-1/2 flex-wrap">
        <div class="w-full p-1 md:p-2 lg:p-3">
          <div class="relative aspect-[16/9] w-full">
            <img
              alt="gallery"
              class="block w-full h-full rounded-xl object-cover object-center cursor-pointer hover:shadow-2xl transition-all duration-300 hover:scale-[1.02]"
              src={smis.src}
              onclick="openModal(0)"
              data-title="(SMIS) Project Manager"
            />
            <div class="absolute inset-0 rounded-xl bg-gradient-to-t from-black/60 via-black/20 to-transparent pointer-events-none"></div>
            <span class="absolute bottom-4 left-4 text-white text-sm sm:text-base md:text-lg lg:text-xl font-bold tracking-wide pointer-events-none max-w-[85%] break-words leading-snug drop-shadow-lg antialiased">
              (SMIS) Project Manager
            </span>
          </div>
        </div>
      </div>
      <div class="flex w-full sm:w-1/2 lg:w-1/2 flex-wrap">
        <div class="w-full p-1 md:p-2 lg:p-3">
          <div class="relative aspect-[16/9] w-full">
            <img
              alt="gallery"
              class="block w-full h-full rounded-xl object-cover object-center cursor-pointer hover:shadow-2xl transition-all duration-300 hover:scale-[1.02]"
              src={Game.src}
              onclick="openModal(1)"
              data-title="Makabre (Game Animator)"
            />
            <div class="absolute inset-0 rounded-xl bg-gradient-to-t from-black/60 via-black/20 to-transparent pointer-events-none"></div>
            <span class="absolute bottom-4 left-4 text-white text-sm sm:text-base md:text-lg lg:text-xl font-bold tracking-wide pointer-events-none max-w-[85%] break-words leading-snug drop-shadow-lg antialiased">
              Makabre (Game Animator)
            </span>
          </div>
        </div>
      </div>
      <div class="flex w-full sm:w-1/2 lg:w-1/2 flex-wrap">
        <div class="w-full p-1 md:p-2 lg:p-3">
            <div class="relative aspect-[16/9] w-full">
          <img
            alt="gallery"
            class="block h-full w-full rounded-xl object-cover object-center cursor-pointer hover:shadow-2xl transition-all duration-300 hover:scale-[1.02]"
            src="https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?w=1200&q=80"
            onclick="openModal(2)"
            data-title="Project 3"
          />
          <div class="absolute inset-0 rounded-xl bg-gradient-to-t from-black/60 via-black/20 to-transparent pointer-events-none"></div>
          <span class="absolute bottom-4 left-4 text-white text-sm sm:text-base md:text-lg lg:text-xl font-bold tracking-wide pointer-events-none max-w-[85%] break-words leading-snug drop-shadow-lg antialiased">
            Project 3
          </span>
        </div>
      </div>
      </div>
      <div class="flex w-full sm:w-1/2 lg:w-1/2 flex-wrap">
        <div class="w-full p-1 md:p-2 lg:p-3">
          <div class="relative aspect-[16/9] w-full">
          <img
            alt="gallery"
            class="block h-full w-full rounded-xl object-cover object-center cursor-pointer hover:shadow-2xl transition-all duration-300 hover:scale-[1.02]"
            src="https://images.unsplash.com/photo-1497366811353-6870744d04b2?w=1200&q=80"
            onclick="openModal(3)"
            data-title="Project 4"
          />
          <div class="absolute inset-0 rounded-xl bg-gradient-to-t from-black/60 via-black/20 to-transparent pointer-events-none"></div>
          <span class="absolute bottom-4 left-4 text-white text-sm sm:text-base md:text-lg lg:text-xl font-bold tracking-wide pointer-events-none max-w-[85%] break-words leading-snug drop-shadow-lg antialiased">
            Project 4
          </span>
          </div>
        </div>
      </div>
      <div class="flex w-full sm:w-1/2 lg:w-1/2 flex-wrap">
        <div class="w-full p-1 md:p-2 lg:p-3">
          <div class="relative aspect-[16/9] w-full">
          <img
            alt="gallery"
            class="block h-full w-full rounded-xl object-cover object-center cursor-pointer hover:shadow-2xl transition-all duration-300 hover:scale-[1.02]"
            src="https://images.unsplash.com/photo-1497366754035-f200968a6e72?w=1200&q=80"
            onclick="openModal(4)"
            data-title="Project 5"
          />
          <div class="absolute inset-0 rounded-xl bg-gradient-to-t from-black/60 via-black/20 to-transparent pointer-events-none"></div>
          <span class="absolute bottom-4 left-4 text-white text-sm sm:text-base md:text-lg lg:text-xl font-bold tracking-wide pointer-events-none max-w-[85%] break-words leading-snug drop-shadow-lg antialiased">
            Project 5
          </span>
          </div>
        </div>
      </div>
      <div class="flex w-full sm:w-1/2 lg:w-1/2 flex-wrap">
        <div class="w-full p-1 md:p-2 lg:p-3">
          <div class="relative aspect-[16/9] w-full">
          <img
            alt="gallery"
            class="block h-full w-full rounded-xl object-cover object-center cursor-pointer hover:shadow-2xl transition-all duration-300 hover:scale-[1.02]"
            src="https://images.unsplash.com/photo-1497215842964-222b430dc094?w=1200&q=80"
            onclick="openModal(5)"
            data-title="Project 6"
          />
          <div class="absolute inset-0 rounded-xl bg-gradient-to-t from-black/60 via-black/20 to-transparent pointer-events-none"></div>
          <span class="absolute bottom-4 left-4 text-white text-sm sm:text-base md:text-lg lg:text-xl font-bold tracking-wide pointer-events-none max-w-[85%] break-words leading-snug drop-shadow-lg antialiased">
            Project 6
          </span>
          </div>
        </div>
      </div>
    </div>
  </div>

<!-- Modal -->
<div id="imageModal" class="fixed inset-0 z-50 hidden bg-black bg-opacity-70 flex items-center justify-center p-4">
  <!-- Close button -->
  <button class="absolute top-4 right-8 text-white text-4xl cursor-pointer hover:text-gray-300 transition-colors" id="closeModal" aria-label="Close modal">&times;</button>
  
  <!-- Previous button -->
  <button class="absolute left-4 sm:left-8 top-1/2 transform -translate-y-1/2 text-white text-5xl cursor-pointer hover:text-gray-300 hover:scale-110 transition-all duration-200 z-10" id="prevBtn" aria-label="Previous image">
    <svg class="w-10 h-10 sm:w-14 sm:h-14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
    </svg>
  </button>

  <!-- Image container -->
  <div class="flex flex-col items-center max-w-4xl">
    <img id="modalImg" class="max-h-[75vh] max-w-[90vw] rounded-lg shadow-2xl" src="" alt="modal" />
    <div id="modalCaption" class="mt-6 text-white text-lg sm:text-xl text-center font-medium"></div>
    <!-- Counter -->
    <div id="imageCounter" class="mt-3 text-gray-300 text-sm"></div>
  </div>

  <!-- Next button -->
  <button class="absolute right-4 sm:right-8 top-1/2 transform -translate-y-1/2 text-white text-5xl cursor-pointer hover:text-gray-300 hover:scale-110 transition-all duration-200 z-10" id="nextBtn" aria-label="Next image">
    <svg class="w-10 h-10 sm:w-14 sm:h-14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
    </svg>
  </button>
</div>

<script>
  interface Project {
    src: string;
    title: string;
  }

  const projects: Project[] = [
    { src: (document.querySelector('img[data-title="(SMIS) Project Manager"]') as HTMLImageElement)?.src || '', title: '(SMIS) Project Manager' },
    { src: (document.querySelector('img[data-title="Makabre (Game Animator)"]') as HTMLImageElement)?.src || '', title: 'Makabre (Game Animator)' },
    { src: 'https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?w=1200&q=80', title: 'Project 3' },
    { src: 'https://images.unsplash.com/photo-1497366811353-6870744d04b2?w=1200&q=80', title: 'Project 4' },
    { src: 'https://images.unsplash.com/photo-1497366754035-f200968a6e72?w=1200&q=80', title: 'Project 5' },
    { src: 'https://images.unsplash.com/photo-1497215842964-222b430dc094?w=1200&q=80', title: 'Project 6' },
  ];

  let currentIndex = 0;

  const openModal = (index: number) => {
    currentIndex = index;
    const modal = document.getElementById('imageModal');
    const modalImg = document.getElementById('modalImg') as HTMLImageElement | null;
    const modalCaption = document.getElementById('modalCaption');
    const imageCounter = document.getElementById('imageCounter');
    
    if (modalImg && projects[index]) {
      modalImg.src = projects[index].src;
      if (modalCaption) modalCaption.textContent = projects[index].title;
      if (imageCounter) imageCounter.textContent = `${index + 1} / ${projects.length}`;
    }
    if (modal) modal.classList.remove('hidden');
  };

  const updateModal = () => {
    const modalImg = document.getElementById('modalImg') as HTMLImageElement | null;
    const modalCaption = document.getElementById('modalCaption');
    const imageCounter = document.getElementById('imageCounter');
    
    if (modalImg && projects[currentIndex]) {
      modalImg.src = projects[currentIndex].src;
      if (modalCaption) modalCaption.textContent = projects[currentIndex].title;
      if (imageCounter) imageCounter.textContent = `${currentIndex + 1} / ${projects.length}`;
    }
  };

  const nextImage = () => {
    currentIndex = (currentIndex + 1) % projects.length;
    updateModal();
  };

  const prevImage = () => {
    currentIndex = (currentIndex - 1 + projects.length) % projects.length;
    updateModal();
  };

  (window as any).openModal = openModal;
  (window as any).nextImage = nextImage;
  (window as any).prevImage = prevImage;

  document.addEventListener('DOMContentLoaded', () => {
    const modal = document.getElementById('imageModal');
    const closeBtn = document.getElementById('closeModal');
    const nextBtn = document.getElementById('nextBtn');
    const prevBtn = document.getElementById('prevBtn');

    if (closeBtn && modal) {
      closeBtn.onclick = () => {
        modal.classList.add('hidden');
      };
      modal.onclick = (e) => {
        if (e.target === modal) modal.classList.add('hidden');
      };
    }

    if (nextBtn) {
      nextBtn.onclick = (e) => {
        e.stopPropagation();
        nextImage();
      };
    }

    if (prevBtn) {
      prevBtn.onclick = (e) => {
        e.stopPropagation();
        prevImage();
      };
    }

    // Keyboard navigation
    document.addEventListener('keydown', (e) => {
      if (modal && !modal.classList.contains('hidden')) {
        if (e.key === 'ArrowRight') nextImage();
        if (e.key === 'ArrowLeft') prevImage();
        if (e.key === 'Escape') modal.classList.add('hidden');
      }
    });
  });
</script>

  </body>
</html>