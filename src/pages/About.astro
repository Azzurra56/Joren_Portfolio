---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Profile from '../assets/Picture.jpg';
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Portfolio | About</title>
  </head>
  <body class="min-h-screen bg-white text-gray-900 antialiased">
    <Header activePath="/About" />

    <main class="relative overflow-hidden">
      <div class="pointer-events-none absolute inset-0 -z-10">
        <div class="absolute -top-24 -left-24 h-72 w-72 rounded-full bg-maroon-100/70 blur-3xl"></div>
        <div class="absolute top-1/3 -right-28 h-80 w-80 rounded-full bg-gold-100/60 blur-3xl"></div>
      </div>

      <section class="mx-auto grid max-w-6xl gap-10 px-4 pt-12 pb-8 sm:px-6 lg:grid-cols-[1.15fr_0.85fr] lg:items-center lg:px-8 lg:pt-16">
        <div>
          <span class="inline-flex items-center rounded-full border border-maroon-200 bg-maroon-50 px-3 py-1 text-xs font-bold tracking-[0.18em] text-maroon-700 uppercase">
            About Me
          </span>
          <h1 class="mt-5 font-serif text-2xl leading-tight text-gray-900 sm:text-3xl lg:text-3xl">
            Building and Gaining experience in Web Development and 
            IT Support/Engineering using ai tools and modern technologies to create reliable and responsive systems.
          </h1>
          <p class="mt-5 max-w-2xl text-base leading-8 text-gray-600 sm:text-lg">
            I am John Clarence Dela Cruz, an aspiring web developer and IT Support/Engineer focused on building reliable systems,
            modern interfaces, and user-friendly workflows with the help of AI. I enjoy turning ideas into polished projects that
            are both functional and visually consistent and responsive.
          </p>

          <div class="mt-8 grid gap-4 sm:grid-cols-3">
            <article class="rounded-2xl border border-gray-200 bg-white/90 p-4 shadow-sm">
              <p class="text-3xl font-black text-maroon-700">4+</p>
              <p class="mt-1 text-sm font-semibold text-gray-600">Years Learning</p>
            </article>
            <article class="rounded-2xl border border-gray-200 bg-white/90 p-4 shadow-sm">
              <p class="text-3xl font-black text-maroon-700">2+</p>
              <p class="mt-1 text-sm font-semibold text-gray-600">Academic Based Projects</p>
            </article>
            <article class="rounded-2xl border border-gray-200 bg-white/90 p-4 shadow-sm">
              <p class="text-3xl font-black text-maroon-700">100%</p>
              <p class="mt-1 text-sm font-semibold text-gray-600">Growth Mindset</p>
            </article>
          </div>
        </div>

        <div class="relative mx-auto w-full max-w-md">
          <div class="absolute -inset-3 rounded-4xl bg-linear-to-br from-maroon-200/70 via-maroon-100/40 to-gold-100/60 blur-sm"></div>
          <div class="relative overflow-hidden rounded-4xl border border-maroon-100 bg-white p-3 shadow-xl">
            <img
              src={Profile.src}
              alt="John Clarence Dela Cruz"
              class="h-105 w-full rounded-[1.4rem] object-cover object-center"
            />
            <div class="absolute right-6 bottom-6 rounded-xl border border-white/40 bg-maroon-700/90 px-4 py-3 text-white backdrop-blur-sm">
              <p class="text-xs uppercase tracking-[0.16em] text-maroon-100">Current Focus</p>
              <p class="mt-1 text-sm font-semibold">IT Support/Engineer</p>
            </div>
          </div>
        </div>
      </section>

      <section class="mx-auto max-w-6xl px-4 py-10 sm:px-6 lg:px-8">
        <div class="grid gap-6 md:grid-cols-3">
          <article class="rounded-3xl border border-gray-200 bg-white p-7 shadow-sm transition duration-300 hover:-translate-y-1 hover:shadow-md">
            <h3 class="text-xl font-bold text-gray-900">What I Do</h3>
            <p class="mt-3 text-sm leading-7 text-gray-600">
              I create and develop with the help of "AI" is school systems, and web app features with a focus on clarity,
              accessibility and maintainable code structure.
            </p>
          </article>

          <article class="rounded-3xl border border-gray-200 bg-white p-7 shadow-sm transition duration-300 hover:-translate-y-1 hover:shadow-md">
            <h3 class="text-xl font-bold text-gray-900">How I Work</h3>
            <p class="mt-3 text-sm leading-7 text-gray-600">
              I start with planning, Expirement with design consistency using "AI" then refine interactions, details, design and performance
              until the final output feels professional and complete.
            </p>
          </article>

          <article class="rounded-3xl border border-gray-200 bg-white p-7 shadow-sm transition duration-300 hover:-translate-y-1 hover:shadow-md">
            <h3 class="text-xl font-bold text-gray-900">What Drives Me</h3>
            <p class="mt-3 text-sm leading-7 text-gray-600">
              I enjoy solving practical problems and continuously improving my craft through projects that mix
              technical depth with thoughtful user experience.
            </p>
          </article>
        </div>
      </section>

      <section class="mx-auto max-w-6xl px-4 pt-2 pb-14 sm:px-6 lg:px-8">
        <div class="rounded-4xl border border-maroon-100 bg-linear-to-r from-maroon-50 via-white to-gold-50 p-8 shadow-sm sm:p-10">
          <div class="grid gap-6 md:grid-cols-[1fr_auto] md:items-center">
            <div>
              <p class="text-xs font-bold uppercase tracking-[0.18em] text-maroon-700">Let us work together</p>
              <h2 class="mt-3 text-3xl font-black text-gray-900 sm:text-4xl">Have a project in mind?</h2>
              <p class="mt-3 max-w-2xl text-sm leading-7 text-gray-600 sm:text-base">
                I am open to collaborations, internship opportunities, and meaningful web projects.
                Feel free to reach out and let us build something excellent.
              </p>
            </div>
            <a
              href="/contact"
              class="inline-flex h-11 items-center justify-center rounded-full bg-maroon-700 px-6 text-sm font-semibold text-white transition hover:bg-maroon-800"
            >
              Contact Me
            </a>
          </div>
        </div>
      </section>
    </main>

  </body>
</html>