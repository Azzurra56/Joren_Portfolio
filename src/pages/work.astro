---
import '../styles/global.css';
import Header from '../components/Header.astro';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Work</title>
  </head>
  <body>
    <Header activePath="/work" />

    <main class="mx-auto max-w-4xl px-6 py-16 lg:px-8">
      <div class="mb-14">
        <span class="inline-flex items-center rounded-full border border-maroon-200 bg-maroon-50 px-3 py-1 text-xs font-bold tracking-[0.18em] text-maroon-700 uppercase">
          Career
        </span>
        <h1 class="mt-5 text-4xl sm:text-5xl font-black text-slate-900 tracking-tight">Work Experience</h1>
        <div class="mt-4 h-1 w-20 bg-maroon-600 rounded-full"></div>
        <p class="mt-6 text-lg text-slate-600 max-w-xl">
          A timeline of my professional growth, internships, and key achievements.
        </p>
      </div>

      <div class="relative">
        <!-- Timeline line -->
        <div class="absolute left-5 top-0 bottom-0 w-0.5 bg-gradient-to-b from-maroon-600 via-maroon-400 to-maroon-100 sm:left-6"></div>

        <ol class="space-y-10">

          <!-- Item 1: DOST Intern -->
          <li class="relative pl-16 sm:pl-20 group">
            <!-- Timeline dot -->
            <div class="absolute left-5 top-6 -translate-x-1/2 flex h-5 w-5 items-center justify-center rounded-full border-4 border-white bg-maroon-600 shadow-lg ring-2 ring-maroon-200 group-hover:scale-110 transition-transform duration-300 sm:left-6"></div>

            <!-- Card -->
            <div class="rounded-2xl border border-slate-200 bg-white p-6 sm:p-7 shadow-sm hover:shadow-lg hover:border-maroon-200 transition-all duration-300">
              <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-3 mb-4">
                <time class="inline-flex items-center gap-1.5 text-sm font-semibold text-maroon-600 bg-maroon-50 border border-maroon-100 px-3 py-1 rounded-full w-fit">
                  <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                  </svg>
                  Feb 2026 – May 2026
                </time>
                <span class="inline-flex items-center rounded-full border border-green-200 bg-green-50 px-2.5 py-0.5 text-xs font-semibold text-green-700 w-fit">
                  Internship
                </span>
              </div>
              <h3 class="text-xl sm:text-2xl font-bold text-sky-600">DOST-STII Intern</h3>
              <p class="mt-1 text-base text-slate-500 font-medium">Department of Science and Technology – STII</p>
              <p class="mt-3 text-base text-slate-600 leading-relaxed">
                Tech Support Intern focused on practicing Front-End development. Provided technical assistance and supported live stream operations for departmental events.
              </p>
              <div class="mt-4 flex flex-wrap gap-2">
                <span class="rounded-full border border-slate-200 bg-slate-50 px-2.5 py-0.5 text-xs font-semibold text-slate-600">Tech Support</span>
                <span class="rounded-full border border-slate-200 bg-slate-50 px-2.5 py-0.5 text-xs font-semibold text-slate-600">Front-End Dev</span>
                <span class="rounded-full border border-slate-200 bg-slate-50 px-2.5 py-0.5 text-xs font-semibold text-slate-600">Live Stream Ops</span>
              </div>
            </div>
          </li>

          <!-- Item 2: Capstone Project Manager -->
          <li class="relative pl-16 sm:pl-20 group">
            <!-- Timeline dot -->
            <div class="absolute left-5 top-6 -translate-x-1/2 flex h-5 w-5 items-center justify-center rounded-full border-4 border-white bg-maroon-500 shadow-lg ring-2 ring-maroon-200 group-hover:scale-110 transition-transform duration-300 sm:left-6"></div>

            <!-- Card -->
            <div class="rounded-2xl border border-slate-200 bg-white p-6 sm:p-7 shadow-sm hover:shadow-lg hover:border-maroon-200 transition-all duration-300">
              <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-3 mb-4">
                <time class="inline-flex items-center gap-1.5 text-sm font-semibold text-maroon-600 bg-maroon-50 border border-maroon-100 px-3 py-1 rounded-full w-fit">
                  <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                  </svg>
                  Oct 2024 – Feb 2026
                </time>
                <span class="inline-flex items-center rounded-full border border-sky-200 bg-sky-50 px-2.5 py-0.5 text-xs font-semibold text-sky-700 w-fit">
                  Academic Project
                </span>
              </div>
              <h3 class="text-xl sm:text-2xl font-bold text-sky-600">Capstone Project Manager</h3>
              <p class="mt-1 text-base text-slate-500 font-medium">Supply Management Information System (SMIS)</p>
              <p class="mt-3 text-base text-slate-600 leading-relaxed">
                Led project direction, requirements checking, and development progression as Fullstack Developer and Project Manager for the SMIS capstone.
              </p>
              <div class="mt-4 flex flex-wrap gap-2">
                <span class="rounded-full border border-slate-200 bg-slate-50 px-2.5 py-0.5 text-xs font-semibold text-slate-600">Laravel</span>
                <span class="rounded-full border border-slate-200 bg-slate-50 px-2.5 py-0.5 text-xs font-semibold text-slate-600">MySQL</span>
                <span class="rounded-full border border-slate-200 bg-slate-50 px-2.5 py-0.5 text-xs font-semibold text-slate-600">PHP</span>
                <span class="rounded-full border border-slate-200 bg-slate-50 px-2.5 py-0.5 text-xs font-semibold text-slate-600">Project Management</span>
              </div>
            </div>
          </li>

          <!-- Item 3: CS Delegates Rep -->
          <li class="relative pl-16 sm:pl-20 group">
            <!-- Timeline dot -->
            <div class="absolute left-5 top-6 -translate-x-1/2 flex h-5 w-5 items-center justify-center rounded-full border-4 border-white bg-maroon-400 shadow-lg ring-2 ring-maroon-100 group-hover:scale-110 transition-transform duration-300 sm:left-6"></div>

            <!-- Card -->
            <div class="rounded-2xl border border-slate-200 bg-white p-6 sm:p-7 shadow-sm hover:shadow-lg hover:border-maroon-200 transition-all duration-300">
              <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-3 mb-4">
                <time class="inline-flex items-center gap-1.5 text-sm font-semibold text-maroon-600 bg-maroon-50 border border-maroon-100 px-3 py-1 rounded-full w-fit">
                  <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                  </svg>
                  Sep 2024 – Jun 2025
                </time>
                <span class="inline-flex items-center rounded-full border border-maroon-200 bg-maroon-50 px-2.5 py-0.5 text-xs font-semibold text-maroon-700 w-fit">
                  Leadership
                </span>
              </div>
              <h3 class="text-xl sm:text-2xl font-bold text-sky-600">Computer Society Delegates Representative</h3>
              <p class="mt-1 text-base text-slate-500 font-medium">PUP-Taguig Campus</p>
              <p class="mt-3 text-base text-slate-600 leading-relaxed">
                Officer responsible for handling events, coordinating with the administration, managing logistics, and facilitating documentation for organization operations.
              </p>
              <div class="mt-4 flex flex-wrap gap-2">
                <span class="rounded-full border border-slate-200 bg-slate-50 px-2.5 py-0.5 text-xs font-semibold text-slate-600">Event Management</span>
                <span class="rounded-full border border-slate-200 bg-slate-50 px-2.5 py-0.5 text-xs font-semibold text-slate-600">Administration</span>
                <span class="rounded-full border border-slate-200 bg-slate-50 px-2.5 py-0.5 text-xs font-semibold text-slate-600">Coordination</span>
              </div>
            </div>
          </li>

          <!-- Item 4: Apprentice Delegates Rep -->
          <li class="relative pl-16 sm:pl-20 group">
            <!-- Timeline dot -->
            <div class="absolute left-5 top-6 -translate-x-1/2 flex h-5 w-5 items-center justify-center rounded-full border-4 border-white bg-maroon-200 shadow-lg ring-2 ring-maroon-100 group-hover:scale-110 transition-transform duration-300 sm:left-6"></div>

            <!-- Card -->
            <div class="rounded-2xl border border-slate-200 bg-white p-6 sm:p-7 shadow-sm hover:shadow-lg hover:border-maroon-200 transition-all duration-300">
              <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-3 mb-4">
                <time class="inline-flex items-center gap-1.5 text-sm font-semibold text-maroon-600 bg-maroon-50 border border-maroon-100 px-3 py-1 rounded-full w-fit">
                  <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                  </svg>
                  Sep 2022 – Jun 2024
                </time>
                <span class="inline-flex items-center rounded-full border border-maroon-200 bg-maroon-50 px-2.5 py-0.5 text-xs font-semibold text-maroon-700 w-fit">
                  Leadership
                </span>
              </div>
              <h3 class="text-xl sm:text-2xl font-bold text-sky-600">Apprentice Delegates Representative</h3>
              <p class="mt-1 text-base text-slate-500 font-medium">Computer Society PUP-T</p>
              <p class="mt-3 text-base text-slate-600 leading-relaxed">
                Assisted logistics, reminders, and event tasking for organization operations under the Computer Society of PUP-Taguig.
              </p>
              <div class="mt-4 flex flex-wrap gap-2">
                <span class="rounded-full border border-slate-200 bg-slate-50 px-2.5 py-0.5 text-xs font-semibold text-slate-600">Logistics</span>
                <span class="rounded-full border border-slate-200 bg-slate-50 px-2.5 py-0.5 text-xs font-semibold text-slate-600">Event Support</span>
                <span class="rounded-full border border-slate-200 bg-slate-50 px-2.5 py-0.5 text-xs font-semibold text-slate-600">Organization Ops</span>
              </div>
            </div>
          </li>

        </ol>
      </div>
    </main>
  </body>
</html>
