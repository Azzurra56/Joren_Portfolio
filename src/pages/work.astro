---
import '../styles/global.css';
import Header from '../components/Header.astro';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Work</title>
  </head>
  <body>
    <Header activePath="/work" />

    <main class="mx-auto max-w-4xl px-6 py-16 lg:px-8">
      <div class="mb-14">
        <h1 class="text-4xl sm:text-5xl font-black text-slate-900 tracking-tight">Work Experience</h1>
        <div class="mt-4 h-1 w-20 bg-maroon-600 rounded-full"></div>
        <p class="mt-6 text-lg text-slate-600">
          A timeline of my professional growth, internships, and key achievements.
        </p>
      </div>

      <div class="relative">
        <!-- Timeline line -->
        <div class="absolute left-0 top-0 bottom-0 w-1 bg-gradient-to-b from-maroon-600 via-maroon-400 to-maroon-200 sm:left-4 md:left-6"></div>

        <ol class="space-y-12 sm:space-y-14">
          <li class="relative pl-8 sm:pl-16 md:pl-20 group">
            <!-- Timeline dot -->
            <div class="absolute left-0 top-2 sm:left-2 md:left-4 w-4 h-4 bg-maroon-600 rounded-full border-4 border-white shadow-lg group-hover:scale-125 transition-transform duration-300"></div>
            
            <!-- Card -->
            <div class="bg-white rounded-xl border border-slate-200 p-6 sm:p-8 shadow-sm hover:shadow-lg hover:border-maroon-300 transition-all duration-300">
              <time class="inline-block text-sm sm:text-base font-semibold text-maroon-600 bg-maroon-50 px-3 py-1 rounded-full mb-4">
                February 2026 - May 2026
              </time>
              <h3 class="text-2xl sm:text-3xl font-bold text-sky-600 mt-3 mb-2">DOST STII Intern</h3>
              <p class="text-base sm:text-lg text-slate-600 leading-relaxed">A Tech Support Intern - Practicing Front-End</p>
            </div>
          </li>

          <li class="relative pl-8 sm:pl-16 md:pl-20 group">
            <!-- Timeline dot -->
            <div class="absolute left-0 top-2 sm:left-2 md:left-4 w-4 h-4 bg-maroon-600 rounded-full border-4 border-white shadow-lg group-hover:scale-125 transition-transform duration-300"></div>
            
            <!-- Card -->
            <div class="bg-white rounded-xl border border-slate-200 p-6 sm:p-8 shadow-sm hover:shadow-lg hover:border-maroon-300 transition-all duration-300">
              <time class="inline-block text-sm sm:text-base font-semibold text-maroon-600 bg-maroon-50 px-3 py-1 rounded-full mb-4">
                January 2025 - February 2026
              </time>
              <h3 class="text-2xl sm:text-3xl font-bold text-sky-600 mt-3 mb-2">Capstone Project Manager</h3>
              <p class="text-base sm:text-lg text-slate-600 leading-relaxed">Fullstack Dev and Project Manager (SMIS)</p>
            </div>
          </li>

          <li class="relative pl-8 sm:pl-16 md:pl-20 group">
            <!-- Timeline dot -->
            <div class="absolute left-0 top-2 sm:left-2 md:left-4 w-4 h-4 bg-maroon-600 rounded-full border-4 border-white shadow-lg group-hover:scale-125 transition-transform duration-300"></div>
            
            <!-- Card -->
            <div class="bg-white rounded-xl border border-slate-200 p-6 sm:p-8 shadow-sm hover:shadow-lg hover:border-maroon-300 transition-all duration-300">
              <time class="inline-block text-sm sm:text-base font-semibold text-maroon-600 bg-maroon-50 px-3 py-1 rounded-full mb-4">
                September 2024 - June 2025
              </time>
              <h3 class="text-2xl sm:text-3xl font-bold text-sky-600 mt-3 mb-2">Computer Society Delegates Representative</h3>
              <p class="text-base sm:text-lg text-slate-600 leading-relaxed">Officer: handles event and signing papers to the administration of PUP-Taguig</p>
            </div>
          </li>
        </ol>
      </div>
    </main>
  </body>
</html>
